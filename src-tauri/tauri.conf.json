{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luminatiles",
  "version": "0.1.0",
  "identifier": "com.otaz.luminatiles",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LuminaTiles",
        "width": 880,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "banner",
        "url": "features/banner/index.html",
        "title": "Banner",
        "width": 1280,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "center": false
      },
      {
        "label": "lock-indicator",
        "url": "features/lock-indicator/index.html",
        "title": "Lock indicator",
        "width": 236,
        "height": 72,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
